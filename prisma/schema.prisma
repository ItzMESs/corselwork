generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  nameEn      String   @default("")
  price       Int
  compareAt   Int?     // previous price, shown struck through when higher than price
  sizes       String[]
  stock       Json?    // { "S": 3, "M": 0 } — a size missing from the map has unlimited stock
  description String   @default("")
  sold        Boolean  @default(false)
  image       Bytes?   // cover image (first in the gallery)
  imageType   String?
  images      ProductImage[] // extra gallery images after the cover
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int
  data      Bytes
  type      String

  @@index([productId])
}

model Order {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  status     String   @default("new") // new | paid | shipped | cancelled
  name       String
  email      String   @default("")
  phone      String
  phone2     String   @default("") // emergency contact
  city       String   @default("") // хот / аймаг
  district   String   @default("") // дүүрэг / сум
  khoroo     String   @default("") // хороо / баг
  building   String   @default("") // байр / гудамж
  apartment  String   @default("") // тоот
  address    String   @default("") // нэмэлт мэдээлэл
  payment    String   @default("bank") // bank | qpay
  items      Json     // [{ id, name, size, qty, price }]
  subtotal   Int
  discount   Int      @default(0)
  total      Int      // items after discount, without delivery
  deliveryFee Int?    // set by admin later; null = not calculated yet
  couponCode String?
  adminNote  String   @default("") // internal note, only visible in admin
}

model Coupon {
  code      String   @id
  percent   Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

// Images for site pages (e.g. slot "about" = the About page gallery)
model SiteImage {
  id       Int    @id @default(autoincrement())
  slot     String
  position Int
  data     Bytes
  type     String

  @@index([slot])
}
